{
  "model": "opus",
  "notifications": true,
  "outputStyle": "concise",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh workflow run *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.mcp-auth/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.zsh.d/**)",
      "Bash(op *)",
      "Bash(security *)",
      "Bash(gh auth token *)",
      "Bash(sudo *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "respectGitignore": true,
  "statusLine": {
    "command": "~/.claude/statusline",
    "type": "command"
  },
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "theme": "dark"
}
